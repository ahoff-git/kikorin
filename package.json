{
  "name": "kikorin",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "turbo dev --filter=web",
    "wasm:build": "pnpm --filter @kikorin/engine-source build:wasm",
    "wasm:dev": "pnpm --filter @kikorin/engine-source dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:stress": "pnpm --filter web test:e2e:stress",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test:all": "turbo run test --parallel",
    "version": "changeset version",
    "release": "turbo build --filter=@kikorin/util && changeset publish",
    "ship": "changeset && changeset version && turbo build --filter=@kikorin/util && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "turbo": "^2.5.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.3"
}
